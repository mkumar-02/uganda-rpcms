# Copy to .env and adjust. Prefix = rpcms_ngo_ (see config.py).
# Host/port also accept RPCMS_NGO_HOST / RPCMS_NGO_PORT via fastapi-common.

# ---- Server ----
RPCMS_NGO_HOST=0.0.0.0
RPCMS_NGO_PORT=8000
RPCMS_NGO_WORKER_TYPE=gunicorn
RPCMS_NGO_NO_OF_WORKERS=1

# ---- Database ----
RPCMS_NGO_DB_DRIVER=postgresql+asyncpg
RPCMS_NGO_DB_HOSTNAME=localhost
RPCMS_NGO_DB_PORT=5432
RPCMS_NGO_DB_USERNAME=rpcms_ngo_user
RPCMS_NGO_DB_PASSWORD=change_me
RPCMS_NGO_DB_DBNAME=openg2p_rpcms_ngo_db

# ---- OpenAPI ----
RPCMS_NGO_OPENAPI_TITLE=RPCMS Partner Onboarding API
RPCMS_NGO_OPENAPI_DESCRIPTION=Uganda RPCMS partner onboarding

# ---- AWE (optional; staff approve is local until enabled) ----
RPCMS_NGO_AWE_ENABLED=false
RPCMS_NGO_AWE_BASE_URL=

# ---- Provisioning (stubs until Registry / PBMS clients are wired) ----
RPCMS_NGO_REGISTRY_PROVISION_ENABLED=false
RPCMS_NGO_PBMS_PROVISION_ENABLED=false

# ---- Auth (shared commons lib; not the rpcms_ngo_ prefix) ----
# For local development without Keycloak:
COMMON_AUTH_ENABLED=false
# COMMON_AUTH_ENABLED=true
# COMMON_AUTH_DEFAULT_ISSUERS=["https://keycloak.example.org/realms/staff"]
# COMMON_AUTH_DEFAULT_JWKS_URLS=["https://keycloak.example.org/realms/staff/protocol/openid-connect/certs"]
# COMMON_AUTH_DEFAULT_AUDIENCES=[]
